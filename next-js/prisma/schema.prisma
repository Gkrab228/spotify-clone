generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  role      Role  @default(USER)
  password  String
  createdAt DateTime @default(now())
}

model Song {
  id          String   @id @default(uuid())
  name        String
  author      String
  imgLink     String
  songLink    String
  timesPlayed Int      @default(0)
  createdAt   DateTime @default(now())
}